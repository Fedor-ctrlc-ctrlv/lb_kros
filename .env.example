
# PostgreSQL Docker
POSTGRES_USER=audit_app
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=linux_audit

# Database connection
DATABASE_URL=postgres://audit_app:replace_with_local_password@localhost:5432/linux_audit?sslmode=disable
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=5432

# Database pool
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=1h
DB_CONNECT_TIMEOUT=5s

# HTTP server
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# JWT authentication
JWT_SECRET=replace_with_a_random_secret_at_least_32_chars_long
